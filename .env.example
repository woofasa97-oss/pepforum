# ─────────────────────────────────────────────────────────────────────────────
# Pepforum environment variables. Copy to apps/web/.env.local (web) or export
# in your shell (worker). Never commit real values: .env* files are gitignored.
# Production values live in Render (render.yaml marks them sync: false).
# ─────────────────────────────────────────────────────────────────────────────

# ── apps/web (Render web service) ────────────────────────────────────────────
# Supabase project URL. Local: http://127.0.0.1:54321 after `supabase start`.
SUPABASE_URL=
# Publishable key (sb_publishable_…, or the legacy anon key). Server-side only:
# the browser never talks to Supabase directly.
SUPABASE_PUBLISHABLE_KEY=
# Public origin of the site (with https://), used for auth email links.
# On Render it defaults to RENDER_EXTERNAL_URL. Local: http://localhost:3000
SITE_URL=http://localhost:3000
# Optional: Cloudflare Turnstile site key. When set, CAPTCHA is shown on
# sign-up/sign-in/reset and the CSP allows challenges.cloudflare.com. Also set
# the matching secret in Supabase Auth → CAPTCHA protection.
TURNSTILE_SITE_KEY=
# Optional: public half of the VAPID pair for web push (…022). Generate once with
# `pnpm --filter @pepforum/worker exec web-push generate-vapid-keys`.
VAPID_PUBLIC_KEY=
# Optional: salts the opaque per-visitor token used to count ad impressions once
# per hour (…025). Any random string; defaults to the publishable key.
AD_VISITOR_SALT=
# Optional: "Continue with Google" handled on your own domain, so Google shows
# your site's name instead of the Supabase address. The same Web client as in
# Supabase → Providers → Google, with <SITE_URL>/auth/oauth/google/callback
# added to its redirect URIs. Leave both blank to use Supabase's flow.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── apps/worker (Render cron job) ────────────────────────────────────────────
# Secret key (sb_secret_…, or legacy service_role). Bypasses RLS: configure it
# ONLY on the worker. The web app refuses to start in production if it sees it.
SUPABASE_SECRET_KEY=
# Optional tuning
SCORING_WINDOW_DAYS=180
DELETIONS_BATCH_SIZE=50
# Web push (…022): both halves of the VAPID pair, and a contact for push services.
# Leave blank to keep notifications in-app only.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:privacy@pepforum.ca
PUSH_BATCH_SIZE=200
# Public origin, for links in push payloads (same value as the web service).
SITE_URL=http://localhost:3000

# ── Supabase CLI (local auth CAPTCHA, optional) ──────────────────────────────
SUPABASE_AUTH_CAPTCHA_SECRET=
